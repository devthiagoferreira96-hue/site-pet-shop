# Copie para .env e preencha. NUNCA coloque valores reais neste arquivo.

# --- Banco (docker compose up -d sobe um Postgres local com estes dados) ---
DATABASE_URL=postgres://petshop:troque-esta-senha-local@localhost:5432/petshop
# Depois de "npm run db:seguranca":
#   DATABASE_ADMIN_URL      = URL do dono do banco (a de cima)
#   DATABASE_URL            = postgres://ma_app:<DB_SENHA_APP>@localhost:5432/petshop
#   DATABASE_MANUTENCAO_URL = postgres://ma_manutencao:<DB_SENHA_MANUTENCAO>@localhost:5432/petshop
DATABASE_ADMIN_URL=
DATABASE_MANUTENCAO_URL=
DATABASE_SSL=0

# --- Segredos (gere com: npm run gerar-segredos) ---
DADOS_CHAVE=
DADOS_CHAVE_ANTERIOR=
DB_SENHA_APP=
DB_SENHA_MANUTENCAO=

# --- Dados legais da loja (obrigatórios em produção) ---
EMPRESA_RAZAO_SOCIAL=Pet Shop Exemplo LTDA
EMPRESA_CNPJ=00.000.000/0001-00
EMPRESA_ENDERECO=Avenida Paulista, 1000 - Bela Vista - São Paulo/SP
EMPRESA_TELEFONE=(11) 99999-9999
EMPRESA_WHATSAPP=11999999999
EMPRESA_EMAIL=contato@exemplo.com
EMPRESA_HORARIO=Seg a sáb, 8h às 18h
LGPD_ENCARREGADO_NOME=Nome do encarregado
LGPD_ENCARREGADO_EMAIL=privacidade@exemplo.com
MAPA_REGISTRO_ESTABELECIMENTO=
RT_VETERINARIO_NOME=
RT_VETERINARIO_CRMV=
FORNECEDOR_HOSPEDAGEM=
FORNECEDOR_EMAIL=
FORNECEDOR_PAGAMENTO=
POLITICAS_DATA=01/01/2026

# --- Entrega ---
ENTREGA_ATIVA=0
ENTREGA_TAXA=0
ENTREGA_AREA=
ENTREGA_PRAZO=

# --- Retenção de dados (LGPD) ---
RETENCAO_CONTATO_DIAS=180
RETENCAO_PEDIDOS_ANOS=5

# --- Opcionais ---
UPLOAD_DIR=uploads
CONFIAR_PROXY=0
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
SEED_TESTE_CARROSSEL=0
